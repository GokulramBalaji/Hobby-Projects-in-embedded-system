# AMT Control System Environment Configuration

# Backend API & WebSocket Port
PORT=5000

# Mosquitto / Embedded MQTT Broker Connection
MQTT_URL=mqtt://127.0.0.1:1883

# Hardware Simulation Mode (Set to true for bench testing without ESP32)
START_SIMULATOR=true

# Frontend API Connections
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws

